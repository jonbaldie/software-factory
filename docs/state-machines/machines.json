{
 "version": 1,
 "machines": [
  {
   "id": "A1",
   "name": "Issue lifecycle",
   "spec": "factory-pipeline.md",
   "storage": "issue labels + agent/issue-N branch",
   "states": [
    "needs-triage",
    "needs-info",
    "ready-for-agent",
    "ready-for-human",
    "wontfix",
    "bug",
    "enhancement",
    "agent:working",
    "agent:failed",
    "agent:wip",
    "OPEN",
    "CLOSED",
    "agent:working",
    "OPEN (PR open)",
    "stand-down (exit 0)",
    "agent:failed (on PR)",
    "stand-down"
   ],
   "labels": [
    "needs-triage",
    "needs-info",
    "ready-for-agent",
    "ready-for-human",
    "wontfix",
    "bug",
    "enhancement",
    "agent:working",
    "agent:failed",
    "agent:wip"
   ],
   "files": [
    "template/.github/workflows/factory-triage.yml",
    "template/.github/workflows/factory-implement.yml",
    "docs/agents/triage-labels.md",
    "template/.github/factory/triage.md",
    "template/.github/factory/ticket.jq"
   ],
   "transitions": [
    {
     "from": "needs-info",
     "event": "reporter-or-maintainer comment",
     "to": "needs-triage"
    },
    {
     "from": "needs-triage",
     "event": "triage verdict",
     "to": "needs-info"
    },
    {
     "from": "needs-triage",
     "event": "triage verdict",
     "to": "ready-for-agent"
    },
    {
     "from": "needs-triage",
     "event": "triage verdict",
     "to": "ready-for-human"
    },
    {
     "from": "needs-triage",
     "event": "triage verdict",
     "to": "wontfix"
    },
    {
     "from": "needs-triage",
     "event": "outsider verdict",
     "to": "ready-for-human"
    },
    {
     "from": "ready-for-agent",
     "event": "implement completed",
     "to": "OPEN (PR open)"
    },
    {
     "from": "ready-for-agent",
     "event": "implement needs-info",
     "to": "needs-info"
    },
    {
     "from": "ready-for-agent",
     "event": "first action",
     "to": "agent:working"
    },
    {
     "from": "*",
     "event": "stage failure/cancel",
     "to": "agent:failed"
    },
    {
     "from": "ready-for-agent",
     "event": "handoff failure after PR",
     "to": "agent:failed (on PR)"
    },
    {
     "from": "ready-for-agent",
     "event": "open PR exists",
     "to": "stand-down"
    },
    {
     "from": "agent:working",
     "event": "issue closed at publication",
     "to": "stand-down"
    }
   ],
   "notes": ""
  },
