#!/usr/bin/env python3
# Fake gh for tests/labels.py. Keeps one PR, its issues and their labels in $FAKE_GH_STATE.
# `gh api` serves REST issues and creates/updates review comments by ID.
import json, os, subprocess, sys

state_path = os.environ["FAKE_GH_STATE"]
with open(state_path) as f:
    st = json.load(f)

args = sys.argv[1:]
st["calls"].append(args)
st.setdefault("auth_calls", []).append({"args": args, "token": os.environ.get("GH_TOKEN")})

VALUE_FLAGS = {"--json", "-q", "--jq", "--body", "--body-file", "--add-label", "--remove-label", "-f", "-R", "--repo", "--reason",
               "--state", "--limit", "--label", "--title", "--search", "--head", "--match-head-commit", "--method", "-F"}
pos, flags = [], {}
i = 0
while i < len(args):
    a = args[i]
    if a in VALUE_FLAGS:
        flags.setdefault(a, []).append(args[i + 1])
        i += 2
    elif a.startswith("-"):
        flags.setdefault(a, []).append(True)
        i += 1
    else:
        pos.append(a)
        i += 1


def save():
    with open(state_path, "w") as f:
        json.dump(st, f, indent=1)


def emit(obj):
    fields = flags.get("--json", [None])[0]
    if fields:
        pick = lambda o: {k: o[k] for k in fields.split(",")}
        obj = [pick(o) for o in obj] if isinstance(obj, list) else pick(obj)
    q = (flags.get("-q") or flags.get("--jq") or [None])[0]
    if q:
        out = subprocess.run(["jq", "-r", q], input=json.dumps(obj), capture_output=True, text=True)
        sys.stdout.write(out.stdout)
        sys.stderr.write(out.stderr)
        sys.exit(out.returncode)
    print(json.dumps(obj))


def labels_of(n):
    return st["pr"]["labels"] if int(n) == st["pr"]["number"] else st["issues"][str(n)]["labels"]


def split(values):
    return [x for v in values for x in v.split(",") if x]


def listed(items):
    """The items `gh issue list` or `gh pr list` would show for --state and --label."""
    state = flags.get("--state", ["open"])[0]
    emit([i for i in items if state in ("all", i["state"].lower())
          and all(name in [l["name"] for l in i["labels"]] for name in flags.get("--label", []))])


def fail(msg):
    sys.stderr.write(msg + "\n")
    save()
    sys.exit(1)


def add_comment(target, body):
    c = {"id": len(target["comments"]) + 1, "author": {"login": "github-actions"}, "authorAssociation": "NONE", "body": body}
    target["comments"].append(c)
    if st.get("push_on_verdict") and body.startswith("<!-- factory:review "):
        st["pr"]["headRefOid"] = "a" * 40
        st["push_on_verdict"] = False
    return c


kind, verb = pos[0], pos[1]
pr = st["pr"]

if kind == "api" and flags.get("--method") == ["POST"] and verb.endswith(f"/issues/{pr['number']}/comments"):
    field = flags["-F"][0]
    if not field.startswith("body=@"):
        fail("fake gh: expected a comment body file")
    c = add_comment(pr, open(field.removeprefix("body=@")).read())
    save()
    emit(c)
elif kind == "api" and flags.get("--method") == ["PATCH"] and "/issues/comments/" in verb:
    c = next(c for c in pr["comments"] if c.get("id") == int(verb.rsplit("/", 1)[1]))
    c["body"] = flags["-f"][0].removeprefix("body=")
    save()
    emit(c)
elif kind == "api":
    issue = st["issues"][pos[1].rsplit("/", 1)[1]]
    author = issue["author"]
    emit({"number": issue["number"], "labels": issue["labels"], "assignees": issue["assignees"],
          "author_association": issue.get("author_association", "NONE"),
          "user": {"login": author["login"].removeprefix("app/") + ("[bot]" if author.get("is_bot") else "")}})
elif (kind, verb) == ("pr", "view"):
    if st.get("head_lookup_failed") and "headRefOid" in flags.get("--json", [""])[0].split(","):
        fail("GitHub could not return the PR head")
    emit(pr)
elif (kind, verb) == ("issue", "view"):
    emit(st["issues"][pos[2]])
elif (kind, verb) == ("issue", "list"):
    listed(st["issues"].values())
elif (kind, verb) == ("issue", "create"):
    n = max([pr["number"], *map(int, st["issues"])]) + 1
    st["issues"][str(n)] = {"number": n, "title": flags["--title"][0], "body": open(flags["--body-file"][0]).read(),
                            "author": {"login": "app/github-actions", "is_bot": True}, "state": "OPEN", "comments": [], "assignees": [],
                            "labels": [{"name": x} for x in split(flags.get("--label", []))]}
    print(f"https://github.com/o/sandbox/issues/{n}")
elif (kind, verb) == ("pr", "list"):
    listed([pr])
elif (kind, verb) == ("pr", "create"):
    pr.update(state="OPEN", title=flags["--title"][0], headRefName=flags["--head"][0],
              body=open(flags["--body-file"][0]).read(), labels=[{"name": x} for x in split(flags.get("--label", []))])
    print(pr["url"])
elif verb == "comment":
    body = flags["--body"][0] if "--body" in flags else open(flags["--body-file"][0]).read()
    target = pr if kind == "pr" else st["issues"][pos[2]]
    add_comment(target, body)
elif verb == "edit":
    labels = labels_of(pos[2])
    names = [l["name"] for l in labels]
    for name in split(flags.get("--remove-label", [])):
        if name not in st["repo_labels"]:
            fail(f"'{name}' not found")
        names = [x for x in names if x != name]
    for name in split(flags.get("--add-label", [])):
        if name not in st["repo_labels"]:
            fail(f"'{name}' not found")
        if name not in names:
            names.append(name)
    labels[:] = [{"name": x} for x in names]
    if kind == "pr" and st.get("push_on_approval") and "agent:approved" in split(flags.get("--add-label", [])):
        pr["headRefOid"] = "a" * 40
        st["push_on_approval"] = False
    if kind == "pr" and st.get("push_on_handoff") and set(split(flags.get("--add-label", []))) & {"agent:changes-requested", "ready-for-human"}:
        pr["headRefOid"] = "a" * 40
        st["push_on_handoff"] = False
    if kind == "pr" and st.get("fail_head_after_approval") and "agent:approved" in split(flags.get("--add-label", [])):
        st["head_lookup_failed"] = True
    if "--body-file" in flags:
        pr["body"] = open(flags["--body-file"][0]).read()
    st["label_history"].append(sorted(names))
elif (kind, verb) == ("issue", "close"):
    if flags["--reason"][0] not in ("completed", "not planned"):
        fail(f"invalid reason {flags['--reason'][0]!r}")
    st["issues"][pos[2]]["state"] = "CLOSED"
elif (kind, verb) == ("pr", "merge"):
    if st.get("push_on_merge"):
        pr["headRefOid"] = "a" * 40
        st["push_on_merge"] = False
    if "--match-head-commit" in flags and flags["--match-head-commit"][0] != pr["headRefOid"]:
        fail("Pull request head does not match the expected commit")
    if not st["merge_ok"] or st.get("checks_pending"):
        fail("Pull request is not mergeable")
    pr["state"] = "MERGED"
elif (kind, verb) == ("pr", "checks"):
    pending = st.get("checks_pending", False)
    st["checks_pending"] = False
    if st.get("push_during_checks"):
        pr["headRefOid"] = "a" * 40
    if st.get("assign_during_checks"):
        pr["assignees"] = [{"login": "maintainer"}]
    save()
    emit([{"bucket": "pending" if pending else "pass"}])
elif (kind, verb) == ("workflow", "run"):
    st["dispatches"].append([pos[2]] + flags.get("-f", []))
else:
    fail(f"fake gh: unsupported command {args}")

save()
